# Single-page app: send /editor, /tools/... to index.html (Hostinger / Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /pdf/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /pdf/index.html [L]
</IfModule>
# Vite emits ES-module workers as .mjs; without this the host serves text/plain
AddType application/javascript .js .mjs
AddType application/wasm .wasm
AddType font/ttf .ttf
